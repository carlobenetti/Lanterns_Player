{
  "name": "@nuclearplayer/plugin-sdk",
  "version": "2.8.3",
  "description": "Shared settings, events and favorites types for the player",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@nuclearplayer/model": "workspace:*"
  },
  "devDependencies": {
    "@nuclearplayer/eslint-config": "workspace:*",
    "@types/react": "^18.3.23",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  },
  "license": "AGPL-3.0-only"
}
